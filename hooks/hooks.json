{
  "sandbox-security-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/agent/.gemini/config/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
