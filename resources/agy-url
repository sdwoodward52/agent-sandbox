#!/bin/bash
#
# Extract the active Antigravity web session URL from tmux pane output.

set -euo pipefail

#######################################
# Main routine to extract Antigravity web URL.
# Arguments:
#   Repository name (optional, defaults to current working directory basename).
# Outputs:
#   Writes the URL to stdout if found.
#######################################
main() {
  local repo_name
  repo_name="${1:-$(basename "${PWD}")}"
  local session_name
  session_name="agy-$(printf '%s' "${repo_name}" | tr -c 'a-zA-Z0-9_-' '_')"

  tmux capture-pane -pt "${session_name}" 2>/dev/null | awk '
/https:\/\/antigravity\.google/ {
    u = $0
    sub(/^.*https:\/\/antigravity\.google/, "https://antigravity.google", u)
    sub(/[[:space:]]+$/, "", u)
    if (u ~ /[[:space:]]/) {
        sub(/[[:space:]].*$/, "", u)
    } else if ((getline n) > 0) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", n)
        if (n !~ /^on([[:space:]]|$)/) {
            sub(/[[:space:]].*$/, "", n)
            if (n ~ /^[0-9a-zA-Z_-]+$/) {
                u = u n
            }
        }
    }
    sub(/\.*$/, "", u)
    print u
    exit
}'
}

main "$@"
